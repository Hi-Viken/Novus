# Integration with Issue Tracker
#
# (note that '\' need to be escaped).

[issuetracker "Gitee-Issue"]
  regex = "#((?!.*Issue|issue|Comme|comme)[A-Za-z0-9]+)"
  url = "https://gitee.com/LongbowEnterprise/Novus/issues/$1?from=project-issue"

[issuetracker "Gitee-Url"]
  regex = "([a-zA-z]+://[^\\s]*)"
  url = "$1"

[issuetracker "Gitee-Commit"]
  regex = "[C|c]ommit:([^\\s]*)"
  url = "https://gitee.com/LongbowEnterprise/Novus/commit/$1"

[issuetracker "Gitee-PR"]
  regex = "!([\\d]+)"
  url = "https://gitee.com/LongbowEnterprise/Novus/pulls/$1"
